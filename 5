    local function ClampTarget(target,x,y)
        local viewport=Gui.AbsoluteSize
        local size=target.AbsoluteSize
        return math.clamp(x,8,math.max(8,viewport.X-size.X-8)),
            math.clamp(y,8,math.max(8,viewport.Y-size.Y-8))
    end

    local function MakeDraggable(handle,target,onRelease)
        local pointer,start,origin,moved
        Connect(handle.InputBegan,function(input)
            if input.UserInputType~=Enum.UserInputType.MouseButton1
            and input.UserInputType~=Enum.UserInputType.Touch then return end
            if UIS:GetFocusedTextBox() then return end
            pointer=input
            start=input.Position
            origin=target.AbsolutePosition
            moved=false
        end)
        Connect(UIS.InputChanged,function(input)
            if not pointer then return end
            local touch=pointer.UserInputType==Enum.UserInputType.Touch
            if touch and input~=pointer then return end
            if not touch and input.UserInputType~=Enum.UserInputType.MouseMovement then return end
            local delta=input.Position-start
            if delta.Magnitude>5 then moved=true end
            if not moved then return end
            local x,y=ClampTarget(target,origin.X+delta.X,origin.Y+delta.Y)
            target.Position=UDim2.fromOffset(x,y)
        end)
        Connect(UIS.InputEnded,function(input)
            if not pointer then return end
            if input~=pointer and not (pointer.UserInputType==Enum.UserInputType.MouseButton1
                and input.UserInputType==Enum.UserInputType.MouseButton1) then return end
            local wasMoved=moved
            pointer=nil
            if onRelease then onRelease(wasMoved) end
        end)
    end

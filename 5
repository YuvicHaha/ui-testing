            T.BackgroundTransparency=1
            T.Position=UDim2.fromOffset(10,2)
            T.Size=UDim2.new(1,-48,0,32)
            T.Font=Enum.Font.GothamSemibold
            T.Text=name or ""
            T.TextColor3=Theme.Text
            T.TextSize=11
            T.TextXAlignment=Enum.TextXAlignment.Left

            B.Parent=H
            B.BackgroundTransparency=1
            B.Size=UDim2.new(1,0,0,36)
            B.Text=""
            B.AutoButtonColor=false

            Icon.Parent=B
            Icon.BackgroundTransparency=1
            Icon.Position=UDim2.new(1,-33,0,10)
            Icon.Size=UDim2.new(0,24,0,17)
            Icon.Image="rbxassetid://3944690667"

            Panel.Parent=H
            Panel.BackgroundColor3=Theme.Row
            Panel.Position=UDim2.new(0,0,0,40)
            Panel.Size=UDim2.new(1,0,0,115)
            Panel.BorderSizePixel=0
            Panel.Visible=false
            Panel.ZIndex=100
            Panel.Active=true

            PC.CornerRadius=UDim.new(0,6)
            PC.Parent=Panel

            Scroll.Parent=Panel
            Scroll.BackgroundTransparency=1
            Scroll.BorderSizePixel=0
            Scroll.Position=UDim2.new(0,4,0,5)
            Scroll.Size=UDim2.new(1,-8,1,-10)
            Scroll.ScrollBarThickness=3
            Scroll.ScrollBarImageColor3=Theme.Purple
            Scroll.ZIndex=101

            Layout.Parent=Scroll
            Layout.HorizontalAlignment=Enum.HorizontalAlignment.Center
            Layout.SortOrder=Enum.SortOrder.LayoutOrder
            Layout.Padding=UDim.new(0,5)

            local open=false
            local selected=nil
            local values={}

            local function UpdateCanvasDropdown()
                Scroll.CanvasSize=UDim2.new(
                    0,
                    0,
                    0,
                    Layout.AbsoluteContentSize.Y/math.max(Scale.Scale,.001)+8
                )
            end

            local function Close()
                open=false
                Panel.Visible=false
                H.Size=UDim2.new(1,-16,0,36)
                Icon.ImageColor3=Color3.new(1,1,1)
                task.defer(UpdateCanvas)
            end

            Connect(B.Activated,function()
                open=not open
                Panel.Visible=open

                H.Size=UDim2.new(
                    1,
                    -16,
                    0,
                    open and 159 or 36
                )

                Icon.ImageColor3=
                    open
                    and Theme.Accent
                    or Color3.new(1,1,1)

                task.defer(UpdateCanvas)
            end)

            local function Build(valuesList)
                values={}

                for _,child in ipairs(Scroll:GetChildren()) do
                    if child:IsA("TextButton") then
                        child:Destroy()
                    end
                end

                for _,v in ipairs(valuesList or {}) do
                    table.insert(values,v)

                    local O=Instance.new("TextButton")
                    local OC=Instance.new("UICorner")

                    O.Parent=Scroll
                    O.BackgroundColor3=Theme.Panel
                    O.BorderSizePixel=0
                    O.Size=UDim2.new(1,0,0,24)
                    O.AutoButtonColor=false
                    O.Font=Enum.Font.GothamSemibold
                    O.Text=tostring(v)
                    O.TextColor3=Theme.Text
                    O.TextSize=10
                    O.ZIndex=102

                    OC.CornerRadius=UDim.new(0,6)
                    OC.Parent=O

                    Connect(O.MouseEnter,function()
                        O.BackgroundColor3=Theme.Hover
                    end)

                    Connect(O.MouseLeave,function()
                        O.BackgroundColor3=Theme.Panel
                    end)

                    Connect(O.Activated,function()
                        selected=v
                        T.Text=tostring(v)
                        Close()
                        pcall(callback,v)
                    end)
                end

                UpdateCanvasDropdown()
            end

            Connect(Scale:GetPropertyChangedSignal("Scale"),UpdateCanvasDropdown)
            Build(list or {})

            Connect(Layout:GetPropertyChangedSignal("AbsoluteContentSize"),
                UpdateCanvasDropdown
            )

            RegisterElement(H,name,"Dropdown")

            RegisterConfig(
                name,
                "Dropdown",
                function()
                    return selected
                end,
                function(v)
                    if v==nil then return end

                    for _,value in ipairs(values) do
                        if tostring(value)==tostring(v) then
                            selected=value
                            T.Text=tostring(value)
                            pcall(callback,value)
                            return
                        end
                    end
                end
            )

            return {
                Object=H,
                Refresh=function(newList)
                    Build(newList or {})
                end,
                Get=function()
                    return selected
                end,
                Set=function(v)
                    for _,value in ipairs(values) do
                        if tostring(value)==tostring(v) then
                            selected=value
                            T.Text=tostring(value)
                            pcall(callback,value)
                            return
                        end
                    end
                end
            }
        end

        local anyVisible=false
        for _,page in ipairs(Folder:GetChildren()) do
            if page:IsA("ScrollingFrame") and page.Visible then anyVisible=true end
        end
        if visible==true or (not anyVisible and pageKey~="Config" and visible~=false) then ShowPage() end
        task.defer(UpdateCanvas)
        return Elements

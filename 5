        --// TOGGLE
        function Elements:addToggle(name,a,b,c,d,e,f)
            local keybind,default,callback,picker,color,colorcb,keybindMode
            local hasBind=false

            if typeof(a)=="EnumItem" then
                keybind=a
                hasBind=true
                callback=b or function() end

                if typeof(c)=="boolean" then
                    default=c
                    picker=d or false
                    color=e
                    colorcb=f
                else
                    default=false
                    picker=c or false
                    color=d
                    colorcb=e
                end
            elseif typeof(a)=="boolean" then
                default=a
                callback=b or function() end
                picker=c or false
                color=d
                colorcb=e
            else
                default=false
                callback=a or function() end
                picker=b or false
                color=c
                colorcb=d
            end

            --// NEW:
            --// If the last argument is true, the GUI toggle only
            --// arms/disarms the keybind. The keybind controls the
            --// actual callback state.
            --
            --// Example:
            --// addToggle("Fly",Enum.KeyCode.T,function(v) ... end,true)
            --
            --// Because of the existing optional arguments, this
            --// detects an explicit boolean in the final position.
            if typeof(f)=="boolean" and picker==false then
                keybindMode=f
            elseif typeof(e)=="boolean" and picker==false and color==nil then
                keybindMode=e
            elseif typeof(d)=="boolean" and picker==false and color==nil then
                keybindMode=d
            else
                keybindMode=false
            end

            --// Clean/simple detection for the common API:
            --// addToggle(name,keybind,callback,true)
            if typeof(a)=="EnumItem"
            and typeof(c)=="boolean"
            and d==nil
            and e==nil
            and f==nil then
                keybindMode=c
                default=false
                picker=false
                color=Color3.new(1,1,1)
                colorcb=function() end
            end

            default=default or false
            color=color or Color3.new(1,1,1)
            colorcb=colorcb or function() end
            keybindMode=keybindMode==true

            local H=Instance.new("Frame")
            local HC=Instance.new("UICorner")
            local T=Instance.new("TextLabel")
            local TB=Instance.new("TextButton")
            local TF=Instance.new("Frame")
            local TFC=Instance.new("UICorner")
            local Ball=Instance.new("Frame")
            local BC=Instance.new("UICorner")
            local Bind=Instance.new("TextButton")
            local BindC=Instance.new("UICorner")

            H.Parent=Home
            H.BackgroundColor3=Theme.Row
            H.BorderSizePixel=0
            H.Size=UDim2.new(1,-16,0,36)
            H.ClipsDescendants=false

            HC.CornerRadius=UDim.new(0,5)
            HC.Parent=H

            T.Parent=H
            T.BackgroundTransparency=1
            T.Position=UDim2.fromOffset(10,0)
            T.Size=UDim2.new(1,picker and -180 or -150,0,36)
            T.Font=Enum.Font.GothamSemibold
            T.Text=name or ""
            T.TextColor3=Theme.Text
            T.TextSize=11
            T.TextXAlignment=Enum.TextXAlignment.Left

            Bind.Parent=H
            Bind.BackgroundColor3=Theme.Selected
            Bind.Position=UDim2.new(1,picker and -150 or -118,0,8)
            Bind.Size=UDim2.new(0,52,0,20)
            Bind.Font=Enum.Font.GothamSemibold
            Bind.TextColor3=Theme.Muted
            Bind.TextSize=10
            Bind.Visible=hasBind or UIS.TouchEnabled

            BindC.CornerRadius=UDim.new(0,4)
            BindC.Parent=Bind

            local currentBind=
                (keybind and keybind~=Enum.KeyCode.Unknown)
                and keybind
                or nil

            if UIS.TouchEnabled then
                Bind.Text="Show"
            elseif currentBind then
                Bind.Text=currentBind.Name:gsub("MouseButton","MB")
            else
                Bind.Text="None"
            end

            TB.Parent=H
            TB.BackgroundTransparency=1
            TB.Position=UDim2.new(1,-60,0,3)
            TB.Text=""
            TB.Size=UDim2.new(0,60,0,30)
            TB.AutoButtonColor=false

            TF.Parent=TB
            TF.BackgroundColor3=Theme.Input
            TF.Position=UDim2.new(.28,0,0,5)
            TF.Size=UDim2.new(0,35,0,20)

            TFC.Parent=TF
            TFC.CornerRadius=UDim.new(0,10)

            Ball.Parent=TF
            Ball.BackgroundColor3=Theme.Text
            Ball.Position=
                default
                and UDim2.new(.46,0,0,4)
                or UDim2.new(.1,0,0,4)
            Ball.Size=UDim2.new(0,14,0,12)

            BC.CornerRadius=UDim.new(1,0)
            BC.Parent=Ball

            local armed=default
            local active=keybindMode and false or default
            local closePicker
            local Row
            local Shortcut
            local function RefreshShortcut()
                if Shortcut and Shortcut.Parent then
                    Shortcut.BackgroundColor3=active and Theme.Accent or Theme.Selected
                    Shortcut.TextColor3=active and Theme.Input or Theme.Text
                end
            end

            local function UpdateSwitch()
                local enabled=keybindMode and armed or active
                Animate(TF,.14,{BackgroundColor3=enabled and Theme.Accent or Theme.Input})
                Animate(Ball,.14,{BackgroundColor3=enabled and Theme.Input or Theme.Text})
            end

            local function RemoveRightRow()
                if Row then
                    Row:Destroy()
                    Row=nil
                end

                ActiveToggleRows[H]=nil
                UpdateTogglePanel()
            end

            local function AddRightRow()
                if Row and Row.Parent then return end

                Row=Instance.new("TextLabel")
                Row.Parent=ToggleList
                Row.BackgroundColor3=Theme.Window
                Row.BorderSizePixel=0
                Row.Size=UDim2.new(1,0,0,21)
                Row.Font=Enum.Font.GothamSemibold
                Row.TextColor3=Theme.Text
                Row.TextSize=8
                Row.TextXAlignment=Enum.TextXAlignment.Left
                Row.ZIndex=202

                local RC=Instance.new("UICorner")
                RC.CornerRadius=UDim.new(0,4)
                RC.Parent=Row

                local RP=Instance.new("UIPadding")
                RP.PaddingLeft=UDim.new(0,6)
                RP.Parent=Row

                ActiveToggleRows[H]=Row

                UpdateTogglePanel()
            end

            local function UpdateRightRow()
                UpdateSwitch()
                RefreshShortcut()
                --// In keybind mode, show the toggle only while armed.
                --// In normal mode, show it while actually enabled.
                local shouldShow=keybindMode and armed or active

                if not shouldShow then
                    RemoveRightRow()
                    return
                end

                AddRightRow()

                if Row then
                    local stateText=active and "ON" or "ARMED"
                    local bindText=currentBind
                        and currentBind.Name:gsub("MouseButton","MB")
                        or "None"

                    Row.Text=
                        (name or "Toggle")
                        .."  ["
                        ..bindText
                        .."] "
                        ..stateText

                    Row.TextColor3=
                        active
                        and Theme.Accent
                        or Theme.Muted
                end
            end

            local function SetActive(v,callCallback)
                v=v==true
                active=v

                if callCallback~=false then
                    pcall(callback,active)
                end

                UpdateRightRow()
            end

            local function SetArmed(v,callCallback)
                v=v==true
                armed=v

                if keybindMode and not armed and active then
                    active=false

                    if callCallback~=false then
                        pcall(callback,false)
                    end
                end

                Ball:TweenPosition(
                    UDim2.new(
                        armed and .46 or .1,
                        0,
                        0,
                        4
                    ),
                    "Out",
                    "Linear",
                    .1,
                    true
                )

                if not armed and closePicker then
                    closePicker()
                end

                UpdateRightRow()

                if callCallback~=false and not keybindMode then
                    pcall(callback,armed)
                end

                task.defer(UpdateCanvas)
            end

            local function UpdateNormal()
                armed=active
                Ball:TweenPosition(
                    UDim2.new(
                        active and .46 or .1,
                        0,
                        0,
                        4
                    ),
                    "Out",
                    "Linear",
                    .1,
                    true
                )

                if not active and closePicker then
                    closePicker()
                end

                UpdateRightRow()

                pcall(callback,active)
                task.defer(UpdateCanvas)
            end

            Connect(TB.Activated,function()
                if keybindMode then
                    SetArmed(not armed,true)
                else
                    active=not active
                    UpdateNormal()
                end
            end)

            --// COLOR PICKER
            if picker then
                local CB=Instance.new("TextButton")
                local CBC=Instance.new("UICorner")
                local Panel=Instance.new("Frame")
                local PC=Instance.new("UICorner")
                local Canvas=Instance.new("ImageButton")
                local Circle=Instance.new("Frame")
                local CC=Instance.new("UICorner")

                CB.Parent=H
                CB.BackgroundColor3=color
                CB.Position=UDim2.new(1,-90,0,8)
                CB.Size=UDim2.new(0,20,0,20)
                CB.Text=""
                CB.ZIndex=50

                CBC.CornerRadius=UDim.new(0,4)
                CBC.Parent=CB

                Panel.Parent=H
                Panel.BackgroundColor3=Theme.Selected
                Panel.Position=UDim2.new(0,4,0,40)
                Panel.Size=UDim2.new(1,-8,0,115)
                Panel.Visible=false
                Panel.ZIndex=60
                Panel.BorderSizePixel=0
                Panel.Active=true

                PC.CornerRadius=UDim.new(0,6)
                PC.Parent=Panel

                Canvas.Parent=Panel
                Canvas.BackgroundTransparency=1
                Canvas.Position=UDim2.new(0,8,0,8)
                Canvas.Size=UDim2.new(1,-16,1,-16)
                Canvas.Image="rbxassetid://143332548"
                Canvas.ZIndex=61
                Canvas.AutoButtonColor=false

                Circle.Parent=Canvas
                Circle.AnchorPoint=Vector2.new(.5,.5)
                Circle.BackgroundColor3=color
                Circle.BorderColor3=Color3.new(0,0,0)
                Circle.BorderSizePixel=2
                Circle.Size=UDim2.new(0,10,0,10)
                Circle.ZIndex=62
                Circle.Position=UDim2.new(.5,0,.5,0)

                CC.CornerRadius=UDim.new(1,0)
                CC.Parent=Circle

                local open=false

                closePicker=function()
                    open=false
                    Panel.Visible=false
                    H.Size=UDim2.new(1,-16,0,36)
                    task.defer(UpdateCanvas)
                end

                Connect(CB.Activated,function()
                    open=not open
                    Panel.Visible=open

                    H.Size=UDim2.new(
                        1,
                        -16,
                        0,
                        open and 159 or 36
                    )

                    local colorOpen=open
                    CB.BackgroundColor3=color

                    if colorOpen then
                        Circle.BackgroundColor3=color
                    end
                end)

                local colorPointer

                local function SetColor(i)
                    local s=Canvas.AbsoluteSize
                    local p=Canvas.AbsolutePosition

                    if s.X<=0 or s.Y<=0 then return end

                    local x=math.clamp(
                        (i.Position.X-p.X)/s.X,
                        0,
                        1
                    )

                    local y=math.clamp(
                        (i.Position.Y-p.Y)/s.Y,
                        0,
                        1
                    )

                    Circle.Position=UDim2.new(x,0,y,0)
                    color=Color3.fromHSV(x,1-y,1)

                    CB.BackgroundColor3=color
                    Circle.BackgroundColor3=color

                    pcall(colorcb,color)
                end

                Connect(Canvas.InputBegan,function(i)
                    if i.UserInputType==Enum.UserInputType.MouseButton1
                    or i.UserInputType==Enum.UserInputType.Touch then

                        colorPointer=i
                        SetColor(i)
                    end
                end)

                Connect(UIS.InputChanged,function(i)
                    if colorPointer and Panel.Visible and Home.Visible and Frame.Visible
                    and ((colorPointer.UserInputType==Enum.UserInputType.Touch and i==colorPointer)
                        or (colorPointer.UserInputType==Enum.UserInputType.MouseButton1
                            and i.UserInputType==Enum.UserInputType.MouseMovement)) then
                        SetColor(i)
                    end
                end)

                Connect(UIS.InputEnded,function(i)
                    if i.UserInputType==Enum.UserInputType.MouseButton1
                    or i.UserInputType==Enum.UserInputType.Touch then
                        if i==colorPointer or (colorPointer
                            and colorPointer.UserInputType==Enum.UserInputType.MouseButton1
                            and i.UserInputType==Enum.UserInputType.MouseButton1) then colorPointer=nil end
                    end
                end)

                RegisterConfig(
                    name.."_Color",
                    "Color3",
                    function()
                        return color
                    end,
                    function(v)
                        local cc=typeof(v)=="Color3" and v or TableToColor(v)

                        if cc then
                            color=cc
                            CB.BackgroundColor3=color
                            Circle.BackgroundColor3=color
                            pcall(colorcb,color)
                        end
                    end
                )
            end

            -- One reusable shortcut per toggle; Show/Hide never adds listeners.
            if UIS.TouchEnabled then
                Connect(Bind.Activated,function()
                    if Shortcut then
                        Shortcut.Visible=not Shortcut.Visible
                        Bind:SetAttribute("Shown",Shortcut.Visible)
                        Bind.Text=Shortcut.Visible and "Hide" or "Show"
                        RefreshShortcut()
                        return
                    end
                    Bind:SetAttribute("Shown",true)
                    Bind.Text="Hide"
                    Shortcut=Instance.new("TextButton")
                    Shortcut.Name=(name or "Toggle").."_Shortcut"
                    Shortcut.Size=UDim2.fromOffset(110,36)
                    local shortcutCount=0
                    for _,child in ipairs(Gui:GetChildren()) do
                        if child:GetAttribute("HalloweenShortcut") then
                            shortcutCount+=1
                        end
                    end
                    local slots=math.max(1,math.floor((Gui.AbsoluteSize.Y-24)/42))
                    local column=math.floor(shortcutCount/slots)
                    local row=shortcutCount%slots
                    Shortcut.Position=UDim2.fromOffset(math.max(8,Gui.AbsoluteSize.X-122-column*116),12+row*42)
                    Shortcut:SetAttribute("HalloweenShortcut",true)
                    Shortcut.Font=Enum.Font.GothamBold
                    Shortcut.Text=name or "Toggle"
                    Shortcut.TextSize=10
                    Shortcut.TextTruncate=Enum.TextTruncate.AtEnd
                    Shortcut.BorderSizePixel=0
                    Shortcut.AutoButtonColor=false
                    Shortcut.ZIndex=250
                    Shortcut.Parent=Gui
                    local corner=Instance.new("UICorner")
                    corner.CornerRadius=UDim.new(0,7)
                    corner.Parent=Shortcut
                    Stroke(Shortcut,Theme.Accent,.5)
                    RefreshShortcut()
                    MakeDraggable(Shortcut,Shortcut,function(moved)
                        if moved then return end
                        if keybindMode then
                            if armed then SetActive(not active,true) end
                        else
                            active=not active
                            UpdateNormal()
                        end
                        RefreshShortcut()
                    end)
                end)
            elseif hasBind then
                local listening=false
                Connect(Bind.Activated,function()
                    Bind.Text="..."
                    task.defer(function() if Alive then listening=true end end)
                end)
                Connect(UIS.InputBegan,function(input,processed)
                    if listening then
                        -- Capture on release so the click that starts listening is ignored.
                        return
                    end
                    if processed or UIS:GetFocusedTextBox() or not currentBind then return end
                    local matches=(currentBind.EnumType==Enum.KeyCode and input.KeyCode==currentBind)
                        or (currentBind.EnumType==Enum.UserInputType and input.UserInputType==currentBind)
                    if matches then
                        if keybindMode then
                            if armed then SetActive(not active,true) end
                        else
                            active=not active
                            UpdateNormal()
                        end
                    end
                end)
                Connect(UIS.InputEnded,function(input)
                    if not listening then return end
                    if input.UserInputType~=Enum.UserInputType.Keyboard
                        and input.UserInputType~=Enum.UserInputType.MouseButton1
                        and input.UserInputType~=Enum.UserInputType.MouseButton2
                        and input.UserInputType~=Enum.UserInputType.MouseButton3 then return end
                    -- Activation happens on release; defer listening one turn below.
                    if input.KeyCode==Enum.KeyCode.Escape or input.KeyCode==Enum.KeyCode.Backspace then
                        currentBind=nil
                    elseif input.UserInputType==Enum.UserInputType.Keyboard then currentBind=input.KeyCode
                    else currentBind=input.UserInputType end
                    Bind.Text=currentBind and currentBind.Name:gsub("MouseButton","MB") or "None"
                    listening=false
                    UpdateRightRow()
                end)
            end

            --// INITIAL STATE
            if keybindMode then
                --// The toggle is only an arming switch.
                --// Never activate the actual feature just because
                --// the GUI was created.
                active=false
                pcall(callback,false)
            else
                active=default
                pcall(callback,active)
            end

            UpdateRightRow()

            RegisterElement(H,name,"Toggle")

            --// CONFIG
            RegisterConfig(
                name,
                "Toggle",
                function()
                    return {
                        Enabled=armed,
                        Active=active,
                        Keybind=SerializeBind(currentBind) or false,
                        KeybindMode=keybindMode
                    }
                end,
                function(v)
                    if type(v)=="boolean" then
                        armed=v

                        if keybindMode then
                            active=false
                        else
                            active=v
                        end
                    elseif type(v)=="table" then
                        armed=v.Enabled==true

                        if v.Keybind==false then
                            currentBind=nil
                            if not UIS.TouchEnabled then Bind.Text="None" end
                        elseif v.Keybind~=nil then
                            local newBind=DeserializeBind(v.Keybind)

                            if newBind then
                                currentBind=newBind

                                if not UIS.TouchEnabled then
                                    Bind.Text=
                                        currentBind.Name:gsub(
                                            "MouseButton",
                                            "MB"
                                        )
                                end
                            end
                        end

                        if keybindMode then
                            active=v.Active==true and armed
                        else
                            if v.Active~=nil then
                                active=v.Active==true
                            else
                                active=armed
                            end
                        end
                    end

                    Ball:TweenPosition(
                        UDim2.new(
                            (keybindMode and armed or active) and .46 or .1,
                            0,
                            0,
                            4
                        ),
                        "Out",
                        "Linear",
                        .1,
                        true
                    )

                    pcall(callback,active)
                    UpdateRightRow()
                end
            )

            return H
        end

        --// SLIDER
        function Elements:addSlider(name,minvalue,maxvalue,callback)
            local min=tonumber(minvalue) or 0
            local max=tonumber(maxvalue) or 100
            if max<min then min,max=max,min end
            local value=min

            local H=Instance.new("Frame")
            local C=Instance.new("UICorner")
            local T=Instance.new("TextLabel")
            local B=Instance.new("TextButton")
            local BC=Instance.new("UICorner")
            local Trail=Instance.new("Frame")
            local TC=Instance.new("UICorner")
            local Num=Instance.new("TextBox")

            H.Parent=Home
            H.BackgroundColor3=Theme.Row
            H.BorderSizePixel=0
            H.Size=UDim2.new(1,-16,0,36)

            C.CornerRadius=UDim.new(0,5)
            C.Parent=H

            T.Parent=H
            T.BackgroundTransparency=1
            T.Position=UDim2.fromOffset(10,3)
            T.Size=UDim2.new(1,-76,0,14)
            T.Font=Enum.Font.GothamSemibold
            T.Text=name or ""
            T.TextColor3=Theme.Text
            T.TextSize=11
            T.TextXAlignment=Enum.TextXAlignment.Left

            Num.Parent=H
            Num.BackgroundTransparency=1
            Num.Position=UDim2.new(1,-60,0,3)
            Num.Size=UDim2.fromOffset(50,15)
            Num.Font=Enum.Font.GothamSemibold
            Num.Text=tostring(min)
            Num.TextColor3=Theme.Text
            Num.TextSize=10
            Num.TextXAlignment=Enum.TextXAlignment.Right
            Num.ClearTextOnFocus=false

            B.Parent=H
            B.BackgroundColor3=Theme.Input
            B.BorderSizePixel=0
            B.Position=UDim2.new(0,10,0,24)
            B.Size=UDim2.new(1,-20,0,6)
            B.Text=""
            B.AutoButtonColor=false

            BC.CornerRadius=UDim.new(0,4)
            BC.Parent=B

            Trail.Parent=B
            Trail.BackgroundColor3=Theme.Accent
            Trail.Size=UDim2.new(0,1,1,0)

            TC.CornerRadius=UDim.new(0,4)
            TC.Parent=Trail

            local function Set(v,callCallback)
                value=math.clamp(
                    tonumber(v) or min,
                    min,
                    max
                )

                Num.Text=tostring(math.floor(value))

                local p=max==min
                    and 0
                    or (value-min)/(max-min)

                Trail.Size=UDim2.new(p,0,1,0)

                if callCallback~=false then
                    pcall(callback,value)
                end

                task.defer(UpdateCanvas)
            end

            local sliderPointer
            local function UpdateFromInput(input)
                local width=B.AbsoluteSize.X
                if width<=0 then return end
                local p=math.clamp((input.Position.X-B.AbsolutePosition.X)/width,0,1)
                Set(min+(max-min)*p,true)
            end
            Connect(B.InputBegan,function(input)
                if input.UserInputType==Enum.UserInputType.MouseButton1
                or input.UserInputType==Enum.UserInputType.Touch then
                    sliderPointer=input
                    UpdateFromInput(input)
                end
            end)
            Connect(UIS.InputChanged,function(input)
                if not sliderPointer or not Home.Visible or not Frame.Visible then return end
                if sliderPointer.UserInputType==Enum.UserInputType.Touch then
                    if input~=sliderPointer then return end
                elseif input.UserInputType~=Enum.UserInputType.MouseMovement then return end
                UpdateFromInput(input)
            end)
            Connect(UIS.InputEnded,function(input)
                if input==sliderPointer or (sliderPointer
                    and sliderPointer.UserInputType==Enum.UserInputType.MouseButton1
                    and input.UserInputType==Enum.UserInputType.MouseButton1) then sliderPointer=nil end
            end)

            Connect(Num.FocusLost,function()
                Set(Num.Text,true)
            end)

            Set(min,false)

            RegisterElement(H,name,"Slider")

            RegisterConfig(
                name,
                "Slider",
                function()
                    return value
                end,
                function(v)
                    Set(v,true)
                end
            )

            return H
        end


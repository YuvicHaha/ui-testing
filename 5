        local c=Instance.new("UICorner")
        c.CornerRadius=UDim.new(1,0)
        c.Parent=dot
        table.insert(embers,{Object=dot,X=random:NextNumber(.04,.94),Phase=random:NextNumber(0,1),Speed=random:NextNumber(.025,.07)})
    end
    local effectsEnabled=true
    -- A bounded, low-frequency animation; paused while the main UI is hidden.
    task.spawn(function()
        local elapsed=0
        while Alive do
            local dt=task.wait(1/20)
            if not Alive then break end
            if effectsEnabled and Frame.Visible then
                elapsed+=dt
                for _,ember in ipairs(embers) do
                    local phase=(ember.Phase+elapsed*ember.Speed)%1
                    ember.Object.Position=UDim2.new(ember.X,math.sin(elapsed+ember.Phase*6)*4,1-phase,0)
                    ember.Object.BackgroundTransparency=.6+.35*math.abs(phase-.5)*2
                end
            end
        end
    end)

    local function StyleRow(row,kind)
        row.ZIndex=12
        for _,child in ipairs(row:GetDescendants()) do
            if child:IsA("GuiObject") then
                child.ZIndex=math.max(child.ZIndex,13)
                if child:IsA("TextLabel") or child:IsA("TextButton") or child:IsA("TextBox") then
                    child.TextTruncate=Enum.TextTruncate.AtEnd
                end
            end
        end
        local border=Stroke(row,Theme.Border,.65)
        if kind~="Label" then
            Connect(row.MouseEnter,function() Animate(border,.16,{Color=Theme.Accent,Transparency=.15}) end)
            Connect(row.MouseLeave,function() Animate(border,.2,{Color=Theme.Border,Transparency=.65}) end)
        end
    end

    local HighlightedObject=nil
    local HighlightedColor=nil
    local HighlightToken=0
    local SearchToken=0

    local function ClearHighlight()
        HighlightToken+=1

        if HighlightedObject
        and HighlightedObject.Parent
        and HighlightedColor then
            HighlightedObject.BackgroundColor3=HighlightedColor
        end

        HighlightedObject=nil
        HighlightedColor=nil
    end

    local function Register(obj,name,page,typ)
        if not obj then return end

        table.insert(AllElements,{
            Object=obj,
            Name=tostring(name or ""),
            Page=page,
            Type=typ
        })
    end

    local function RegisterConfig(name,typ,getter,setter)
        table.insert(ConfigEntries,{
            Name=tostring(name or ""),
            Type=typ,
            Get=getter,
            Set=setter
        })
    end

    --// SEARCH
    local function Search(query)
        SearchToken+=1
        local token=SearchToken

        query=tostring(query or "")
        query=query:lower()
        query=query:gsub("^%s+","")
        query=query:gsub("%s+$","")

        if query=="" then
            ClearHighlight()
            return
        end

        for _,data in ipairs(AllElements) do
            if data.Name:lower():find(query,1,true) then
                local page=data.Page

                if not page or not page.Parent then return end

                for _,p in ipairs(Folder:GetChildren()) do
                    if p:IsA("ScrollingFrame") then
                        p.Visible=false
                    end
                end

                page.Visible=true

                for name,tab in pairs(PageTabs) do
                    if name==page.Name then
                        tab.TextTransparency=0
                        tab.BackgroundColor3=Theme.Selected
                    else
                        tab.TextTransparency=.3
                        tab.BackgroundColor3=Theme.Panel
                    end
                end

                task.defer(function()
                    task.wait()
                    if not Alive then return end

                    if token~=SearchToken then return end
                    if not data.Object or not data.Object.Parent then return end

                    local y=
                        data.Object.AbsolutePosition.Y
                        -page.AbsolutePosition.Y
                    y=y/math.max(Scale.Scale,.001)
                        +page.CanvasPosition.Y
                        -12

                    local maxY=math.max(
                        0,
                        (page.AbsoluteCanvasSize.Y-page.AbsoluteSize.Y)/math.max(Scale.Scale,.001)
                    )

                    page.CanvasPosition=Vector2.new(
                        0,
                        math.clamp(y,0,maxY)
                    )

                    ClearHighlight()

                    HighlightToken+=1
                    local ht=HighlightToken

                    HighlightedObject=data.Object
                    HighlightedColor=data.Object.BackgroundColor3

                    data.Object.BackgroundColor3=Theme.Highlight

                    task.delay(.55,function()
                        if not Alive then return end
                        if ht~=HighlightToken then return end

                        if HighlightedObject==data.Object
                        and HighlightedObject.Parent
                        and HighlightedColor then

                            HighlightedObject.BackgroundColor3=HighlightedColor
                        end

                        HighlightedObject=nil
                        HighlightedColor=nil
                    end)
                end)

                return
            end
        end

        ClearHighlight()
    end

    Connect(SearchBox:GetPropertyChangedSignal("Text"),function()
        Search(SearchBox.Text)
    end)


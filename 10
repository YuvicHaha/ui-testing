    local function QueueCanvasUpdate(fn)
        if not alive then return end
        if not PerformanceMode then
            task.defer(function() if alive then fn() end end)
            return
        end
        PendingCanvasUpdates[fn]=true
        if UIRefreshQueued then return end
        UIRefreshQueued=true
        task.delay(.06,function()
            UIRefreshQueued=false
            local pending=PendingCanvasUpdates
            PendingCanvasUpdates={}
            if not alive then return end
            for callback in pairs(pending) do pcall(callback) end
        end)
    end

        MakeHandle("ResizeLeft",Vector2.new(0,0),UDim2.new(0,0,0,14),UDim2.new(0,5,1,-28),99)
        MakeHandle("ResizeRight",Vector2.new(1,0),UDim2.new(1,0,0,14),UDim2.new(0,5,1,-28),99)
        MakeHandle("ResizeTop",Vector2.new(0,0),UDim2.new(0,14,0,0),UDim2.new(1,-28,0,5),99)
        MakeHandle("ResizeBottom",Vector2.new(0,1),UDim2.new(0,14,1,0),UDim2.new(1,-28,0,5),99)
        MakeHandle("ResizeTopLeft",Vector2.new(0,0),UDim2.new(0,0,0,0),UDim2.fromOffset(14,14),100)
        MakeHandle("ResizeTopRight",Vector2.new(1,0),UDim2.new(1,0,0,0),UDim2.fromOffset(14,14),100)
        MakeHandle("ResizeBottomLeft",Vector2.new(0,1),UDim2.new(0,0,1,0),UDim2.fromOffset(14,14),100)

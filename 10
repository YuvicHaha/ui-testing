    -- Floating pickers follow their swatches through resizing, dragging and scrolling.
    -- Their original color mapping/callbacks are untouched.
    local function TrackPicker(anchor,panel,owner,onHide)
        local page=owner.Parent
        local function Hide()
            if not panel.Parent then return end
            if panel.Visible then panel.Visible=false end
            onHide()
        end
        local function Position()
            if not panel.Parent or not anchor.Parent or not owner.Parent then return end
            if not Frame.Visible or not owner.Visible or (page and not page.Visible) then
                Hide()
                return
            end
            local p=anchor.AbsolutePosition-Gui.AbsolutePosition
            local size=panel.AbsoluteSize
            local viewport=Gui.AbsoluteSize
            local x=p.X-120
            local y=p.Y+anchor.AbsoluteSize.Y+4
            if y+size.Y>viewport.Y-4 then y=p.Y-size.Y-4 end
            panel.Position=UDim2.fromOffset(
                math.clamp(x,4,math.max(4,viewport.X-size.X-4)),
                math.clamp(y,4,math.max(4,viewport.Y-size.Y-4)))
        end
        local function Refresh() if panel.Visible then Position() end end
        Connect(anchor:GetPropertyChangedSignal("AbsolutePosition"),Refresh,owner)
        Connect(anchor:GetPropertyChangedSignal("AbsoluteSize"),Refresh,owner)
        Connect(Gui:GetPropertyChangedSignal("AbsoluteSize"),Refresh,owner)
        Connect(panel:GetPropertyChangedSignal("Visible"),Refresh,owner)
        Connect(Frame:GetPropertyChangedSignal("Visible"),Refresh,owner)
        Connect(owner:GetPropertyChangedSignal("Visible"),Refresh,owner)
        if page and page:IsA("GuiObject") then
            Connect(page:GetPropertyChangedSignal("Visible"),Refresh,owner)
            if page:IsA("ScrollingFrame") then
                Connect(page:GetPropertyChangedSignal("CanvasPosition"),Refresh,owner)
            end
        end
        return Position

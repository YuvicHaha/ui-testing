        local function MakeHandle(name,anchor,position,size,zindex)
            local Handle=Instance.new("TextButton")
            Handle.Name=name
            Handle.BackgroundTransparency=1
            Handle.BorderSizePixel=0
            Handle.AnchorPoint=anchor
            Handle.Position=position
            Handle.Size=size

            local mouse=pointer.UserInputType==Enum.UserInputType.MouseButton1
                and i.UserInputType==Enum.UserInputType.MouseMovement
            if not mouse and i~=pointer then return end
            local delta=(i.Position-startPointer)/startScale
            local left=edge:find("Left",1,true)~=nil
            local right=edge:find("Right",1,true)~=nil
            local top=edge:find("Top",1,true)~=nil
            local bottom=edge:find("Bottom",1,true)~=nil
            local width=startSize.X
            local height=startSize.Y
            if left or right then
                width=math.clamp(startSize.X+(left and -delta.X or delta.X),455,900)
            end
            if top or bottom then
                height=math.clamp(startSize.Y+(top and -delta.Y or delta.Y),300,650)
            end
            -- Use the clamped size to keep the opposite edges stationary.
            local dx=left and (startSize.X-width)*startScale or 0
            local dy=top and (startSize.Y-height)*startScale or 0
            Frame.Position=UDim2.new(startPosition.X.Scale,startPosition.X.Offset+dx,
                startPosition.Y.Scale,startPosition.Y.Offset+dy)
            Frame.Size=UDim2.fromOffset(width,height)
        end)

                if i.UserInputType~=Enum.UserInputType.MouseButton1
                and i.UserInputType~=Enum.UserInputType.Touch then return end
                dragging=false
                pointer=i
                edge=name
                startPointer=i.Position
                startScale=math.max(Scale.Scale,.01)
                startSize=Vector2.new(Frame.Size.X.Offset,Frame.Size.Y.Offset)
                startPosition=Frame.Position
                Frame:SetAttribute("Resizing",true)
                OnRelease(i,function() if pointer==i then StopResize() end end)
            end,Handle)
        end

        function Elements:addSlider(name,a,b,c,d)
            local min,max,value,callback,rounding
            local function finite(v,fallback)
                v=tonumber(v)
                if not v or v~=v or math.abs(v)==math.huge then return fallback end
                return v
            end
            if type(a)=="table" then
                local o=a
                name=o.Text or name
                min=finite(o.Min,0)
                max=finite(o.Max,100)
                value=tonumber(o.Default)
                rounding=math.clamp(math.floor(finite(o.Rounding,0)),0,10)
                callback=o.Callback or function() end
            else
                min=finite(a,0)
                max=finite(b,100)
                callback=c or function() end
                value=tonumber(d)
                rounding=0
            end
            if max<min then min,max=max,min end
            local step=10^-rounding
            local function roundValue(v)
                v=finite(v,min)
                v=math.clamp(v,min,max)
                if rounding>0 then
                    v=math.round(v/step)*step
                    v=math.clamp(v,min,max)
                else
                    v=math.floor(v+0.5)
                    v=math.clamp(v,min,max)
                end
                return v
            end
            value=roundValue(value or min)

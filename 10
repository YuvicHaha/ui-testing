        local function IsShowing(owner)
            local ancestor=owner
            while ancestor and ancestor~=Gui do
                if ancestor:IsA("GuiObject") and not ancestor.Visible then return false end
                ancestor=ancestor.Parent
            end
            return ancestor==Gui
        end
        local function ResetEffects()
            Layer.Visible=false
            windowInside=false
            windowAmount=0
            if border and border.Parent then border.Transparency=.78 end
            for _,state in pairs(HalloweenHoverTargets) do

    end
    local function RegisterWindowConfig(name,typ,getter,setter,pageName,plugin)
        -- Management fields must not overwrite the config being loaded.
        if pageName=="Config" and name=="Auto Load" then AutoLoadSetter=setter return end
        if pageName=="Config" and name=="" then return end
        local base=HttpService:JSONEncode({pageName,typ,tostring(name or "")})
        local scope=plugin and plugin.File or "main"
        local counterKey=scope.."|"..base
        ConfigKeyCounts[counterKey]=(ConfigKeyCounts[counterKey] or 0)+1
        local key=base.."#"..ConfigKeyCounts[counterKey]
        local okDefault,defaultValue=pcall(getter)
        local entry={
            Name=tostring(name or ""),
            Key=key,
            Type=typ,
            Get=getter,
            Set=setter,
            Default=Clone(defaultValue),
            Plugin=plugin
        }
        table.insert(ResetEntries,entry)
        if plugin then
table.insert(PluginConfigEntries, entry)
        else
table.insert(ConfigEntries, entry)
        end
        -- Autoload may finish before callers build their own pages.
        if not plugin and LoadedConfigData and type(LoadedConfigData.Values)=="table" then
            local saved=LoadedConfigData.Values[key] or LoadedConfigData.Values[entry.Name]
            if type(saved)=="table" and (saved.Type==nil or saved.Type==typ) and saved.Value~=nil then
                pcall(setter,Clone(saved.Value))
            end
        end
    end
    --// SEARCH
    local function Search(query)
        SearchToken+=1
        local token=SearchToken
        query=tostring(query or "")
        query=query:lower()
        query=query:gsub("^%s+","")
        query=query:gsub("%s+$","")
        if query=="" then
            ClearHighlight()
            return
        end
        for _,data in ipairs(AllElements) do
            if data.Object and data.Object.Parent and data.Page and data.Page.Parent and data.Name:lower():find(query,1,true) then
                local page=data.Page
                if not page or not page.Parent then return end
                for _,p in ipairs(Folder:GetChildren()) do
                    if p:IsA("ScrollingFrame") then p.Visible=false end
                end
                page.Visible=true
                for name,tab in pairs(PageTabs) do
                    if name==page.Name then
                        tab.TextTransparency=0
                        tab.BackgroundColor3=Color3.fromRGB(25,25,25)
                    else
                        tab.TextTransparency=.3
                        tab.BackgroundColor3=Color3.fromRGB(15,15,15)
                    end
                end
                task.defer(function()
                    task.wait()
                    if not alive or token~=SearchToken then return end
                    if not data.Object
                    or not data.Object.Parent then
                        return
                    end
                    local y=
                        data.Object.AbsolutePosition.Y
                        -page.AbsolutePosition.Y
                        +page.CanvasPosition.Y
                        -12
local maxY=math.max(0, page.AbsoluteCanvasSize.Y-page.AbsoluteSize.Y)
page.CanvasPosition=Vector2.new(0, math.clamp(y,0,maxY))
                    ClearHighlight()
                    HighlightToken+=1
                    local ht=HighlightToken
                    HighlightedObject=data.Object
                    HighlightedColor=data.Object.BackgroundColor3
                    data.Object.BackgroundColor3=
                        Color3.fromRGB(35,70,75)
                    task.delay(.55,function()
                        if ht~=HighlightToken then return end
                        if HighlightedObject==data.Object
                        and HighlightedObject.Parent
                        and HighlightedColor then
                            HighlightedObject.BackgroundColor3=
                                HighlightedColor
                        end
                        HighlightedObject=nil
                        HighlightedColor=nil
                    end)
                end)
                return
            end
        end
        ClearHighlight()
    end

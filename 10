            if not Frame.Visible or PerformanceMode then
                if not effectsPaused then ResetEffects() effectsPaused=true end
                return
            end
            effectsPaused=false
            Layer.Visible=true
            dt=math.min(math.max(dt,0),.05)
            clock+=dt
            local smoothing=1-math.exp(-dt*15)
            local interacting=dragging or Frame:GetAttribute("Resizing")
            local focused=UIS:GetFocusedTextBox()~=nil
            local hoverAllowed=not interacting and not focused
            local target=windowInside and hoverAllowed and 1 or 0
            windowAmount+=(target-windowAmount)*smoothing
            if border and border.Parent then
                border.Transparency=.78-windowAmount*.20
            end
            for owner,state in pairs(HalloweenHoverTargets) do
                if owner.Parent and state.Stroke.Parent then
                    local goal=state.Inside and hoverAllowed and IsShowing(owner) and 1 or 0
                    state.Amount+=(goal-state.Amount)*smoothing
                    -- Only this dedicated outline animates; switch/color state is untouched.
                    state.Stroke.Transparency=1-state.Amount*.38
                end
            end
            local width=Frame.Size.X.Offset
            local height=Frame.Size.Y.Offset
            local pointer=UIS:GetMouseLocation()
            local framePosition=Frame.AbsolutePosition
            local factor=math.max(Scale.Scale,.01)
            local mouseX=(pointer.X-framePosition.X)/factor
            local mouseY=(pointer.Y-framePosition.Y)/factor
            for _,mote in ipairs(motes) do
                mote.Age=(mote.Age+dt)%mote.Duration
                local progress=mote.Age/mote.Duration
                local fade=math.min(math.clamp(progress/.15,0,1),
                    math.clamp((1-progress)/.20,0,1))
                local x=math.clamp(width*mote.Lane+math.sin(clock*.34+mote.Phase)*3,
                    mote.Size,width-mote.Size)
                local y=height+mote.Size-progress*(height+2*mote.Size)
                local distance=math.sqrt((x-mouseX)^2+(y-mouseY)^2)
                -- Fade further near the pointer, while editing, or while dragging/resizing.
                local clearance=.2+.8*math.clamp((distance-22)/36,0,1)
                local opacity=mote.Opacity*fade*clearance
                if focused or interacting then opacity*=.25 end
                mote.Object.Position=UDim2.fromOffset(x,y)
                if mote.Emoji then
                    mote.Object.TextTransparency=1-opacity
                    mote.Object.Rotation=math.sin(clock*.24+mote.Phase)*4
                else
                    mote.Object.BackgroundTransparency=1-opacity
                end
            end
        end,Layer)
        Gui.Destroying:Once(function()
            table.clear(motes)
            table.clear(HalloweenHoverTargets)
        end)
    end


local function UpdateBackgroundAppearance()
    BackgroundImage.ImageTransparency=math.clamp(BackgroundTransparencyValue/100,0,1)
    BackgroundShade.BackgroundTransparency=1-math.clamp(BackgroundDarknessValue/100,0,.8)
    local active=BackgroundImage.Visible and BackgroundImage.Image~=""
    BackgroundShade.Visible=active
    local panelAlpha=math.clamp(PanelTransparencyValue/100,0,.45)
    Dash.BackgroundTransparency=active and math.max(.14,panelAlpha) or panelAlpha
    Pages.BackgroundTransparency=active and math.max(.11,panelAlpha) or panelAlpha
end

local function ApplyBackground(url)
    url=tostring(url or ""):gsub("^%s+",""):gsub("%s+$","")
    if url=="" then
        SetBackgroundStatus("Enter an image URL first",false)
        return false
    end
    if url:match("^%d+$") then url="rbxassetid://"..url end
    if url:match("^rbxassetid://") or url:match("^rbxasset://") or url:match("^rbxthumb://") then
        BackgroundImage.Image=url
        BackgroundImage.Visible=true
        UpdateBackgroundAppearance()
        SetBackgroundStatus("Background applied",true)
        return true
    end
    if not url:match("^https?://") then
        SetBackgroundStatus("Use a direct image URL or Roblox asset ID",false)
        return false
    end
    if type(writefile)~="function" then
        SetBackgroundStatus("This executor does not support local image assets",false)
        return false
    end
    local cleanURL=url:match("^([^?#]+)") or url
    local extension=(cleanURL:match("%.([%w]+)$") or "png"):lower()
    if extension=="jpeg" then extension="jpg" end
    if extension~="png" and extension~="jpg" then
        SetBackgroundStatus("Use a direct .png, .jpg or .jpeg link",false)
        return false
    end
    local downloaded,contents=pcall(function() return game:HttpGet(url) end)
    if not downloaded or type(contents)~="string" or #contents<32 then
        SetBackgroundStatus("Could not download that image link",false)
        return false
    end
    if not SetupFolder() then
        SetBackgroundStatus("Skido folder or file access is unavailable",false)
        return false
    end
    local path=ConfigFolder.."/background."..extension
    local saved=pcall(function() writefile(path,contents) end)
    if not saved then
        SetBackgroundStatus("Could not save the background image",false)
        return false
    end
    local assetLoader=getcustomasset or getsynasset
    if type(assetLoader)~="function" then
        SetBackgroundStatus("This executor cannot load saved images as UI assets",false)
        return false
    end
    local loaded,asset=pcall(assetLoader,path)
    if not loaded or type(asset)~="string" then
        SetBackgroundStatus("The downloaded image could not be loaded",false)
        return false
    end
    BackgroundImage.Image=asset
    BackgroundImage.Visible=true
    UpdateBackgroundAppearance()
    SetBackgroundStatus("Background applied",true)
    return true
end


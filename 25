    local function ColorKey(color)
        return tostring(math.floor(color.R*255+.5))..","..
            tostring(math.floor(color.G*255+.5))..","..
            tostring(math.floor(color.B*255+.5))
    end

    local function BuildThemePalette()
        local source=ThemePalettes[CurrentThemeName] or ThemePalettes.Midnight
        local palette={}
        for key,value in pairs(source) do palette[key]=value end
        if UseCustomAccent then
            palette.Accent=CustomAccentColor
            palette.Accent2=CustomAccentColor:Lerp(source.Accent2,.42)
            palette.AccentStroke=CustomAccentColor:Lerp(Color3.new(1,1,1),.12)
        end
        return palette
    end

    local function ApplyThemeObject(object)
        if not object or not object.Parent and object~=Gui then return end
        if object:IsA("GuiObject") then
            local role=object:GetAttribute("SkidoBackgroundRole")
            if not role then
                role=BaseBackgroundRoles[ColorKey(object.BackgroundColor3)]
                if role then object:SetAttribute("SkidoBackgroundRole",role) end
            end
            if role and ThemePalette[role] then object.BackgroundColor3=ThemePalette[role] end
        end
        if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
            local role=object:GetAttribute("SkidoTextRole")
            if not role then
                role=BaseTextRoles[ColorKey(object.TextColor3)]
                if role then object:SetAttribute("SkidoTextRole",role) end
            end
            if role and ThemePalette[role] then object.TextColor3=ThemePalette[role] end
            if object:IsA("TextBox") then
                local placeholderRole=object:GetAttribute("SkidoPlaceholderRole")
                if not placeholderRole then
                    placeholderRole=BaseTextRoles[ColorKey(object.PlaceholderColor3)]
                    if placeholderRole then object:SetAttribute("SkidoPlaceholderRole",placeholderRole) end
                end
                if placeholderRole and ThemePalette[placeholderRole] then object.PlaceholderColor3=ThemePalette[placeholderRole] end
            end
        end
        if object:IsA("UIStroke") then
            local role=object:GetAttribute("SkidoStrokeRole")
            if not role then
                role=BaseStrokeRoles[ColorKey(object.Color)]
                if role then object:SetAttribute("SkidoStrokeRole",role) end
            end
            if role and ThemePalette[role] then object.Color=ThemePalette[role] end
        end
    end

    local function GradientRotation()
        if GradientDirection=="Horizontal" then return 0 end
        if GradientDirection=="Vertical" then return 90 end
        if GradientDirection=="Reverse Diagonal" then return 135 end
        return 45
    end

    local function UpdateThemeGradients()
        local targets={Frame,Dash,Pages,TogglePanel,ResetButton,Min,Float}
        local rotation=GradientRotation()
        local amount=math.clamp(GradientStrength/100,0,1)
        local alpha=amount*(GradientStyle=="Accent" and .58 or .36)
        for _,target in ipairs(targets) do
            if target and target.Parent then
                local gradient=target:FindFirstChild("SkidoThemeGradient")
                if not gradient then
                    gradient=Instance.new("UIGradient")
                    gradient.Name="SkidoThemeGradient"
                    gradient.Parent=target
                end
                gradient.Rotation=rotation
                if GradientStyle=="Off" or amount<=0 then
                    gradient.Transparency=NumberSequence.new(1)
                    gradient.Color=ColorSequence.new(ThemePalette.Window)
                elseif GradientStyle=="Accent" then
                    gradient.Color=ColorSequence.new({
                        ColorSequenceKeypoint.new(0,ThemePalette.Accent),
                        ColorSequenceKeypoint.new(1,ThemePalette.Accent2)
                    })
                    gradient.Transparency=NumberSequence.new(1-alpha)
                elseif GradientStyle=="Aurora" then
                    gradient.Color=ColorSequence.new({
                        ColorSequenceKeypoint.new(0,ThemePalette.GradientA),
                        ColorSequenceKeypoint.new(.52,ThemePalette.GradientC),
                        ColorSequenceKeypoint.new(1,ThemePalette.GradientB)
                    })
                    gradient.Transparency=NumberSequence.new(1-alpha)
                else
                    gradient.Color=ColorSequence.new({
                        ColorSequenceKeypoint.new(0,ThemePalette.GradientA),
                        ColorSequenceKeypoint.new(1,ThemePalette.GradientB)
                    })
                    gradient.Transparency=NumberSequence.new(1-alpha)
                end
            end
        end
    end

    local function ApplyTheme()
        ThemePalette=BuildThemePalette()
        for _,object in ipairs(Gui:GetDescendants()) do
            ApplyThemeObject(object)
        end
        for _,state in pairs(ThemeHoverTargets) do
            if state.Stroke and state.Stroke.Parent then state.Stroke.Color=ThemePalette.AccentStroke end
        end
        local outline=Frame:FindFirstChild("SkidoThemeOutline")
        if outline then outline.Color=ThemePalette.AccentStroke end
        local accentLine=Frame:FindFirstChild("SkidoThemeAccentLine")
        if accentLine then accentLine.BackgroundColor3=ThemePalette.Accent end
        for _,tab in pairs(PageTabs) do
            if tab and tab.Parent then
                tab.BackgroundColor3=tab.TextTransparency==0 and ThemePalette.TabActive or ThemePalette.TabInactive
                tab.TextColor3=ThemePalette.Text
            end
        end
        UpdateThemeGradients()
    end

    local function SetTheme(name)

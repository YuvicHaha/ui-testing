local function SetBackgroundStatus(message,good)
    if not BackgroundStatus then return end
    BackgroundStatus.Text=tostring(message or "")
    BackgroundStatus.TextColor3=good and ThemePalette.Accent or Color3.fromRGB(190,145,135)

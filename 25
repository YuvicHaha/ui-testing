        outline.Color=ThemePalette.AccentStroke
        outline.Thickness=1
        outline.Transparency=1
        outline.Parent=owner
        local state={Stroke=outline}
        ThemeHoverTargets[owner]=state
        Connect(owner.MouseEnter,function()
            if outline.Parent then outline.Transparency=.32 end
        end,owner)
        Connect(owner.MouseLeave,function()
            if outline.Parent then outline.Transparency=1 end
        end,owner)
        owner.Destroying:Once(function() ThemeHoverTargets[owner]=nil end)
    end

